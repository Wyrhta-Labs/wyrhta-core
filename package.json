{
  "name": "@wyrhta/core",
  "version": "0.3.0",
  "description": "Shared foundation for Wyrhta Labs services: identity, auth, HTTP kit, household, DB conventions",
  "type": "module",
  "files": ["dist"],
  "comment:exports": "Each subpath lists 'default' as well as 'import' so CJS tooling (e.g. drizzle-kit, which require()s the schema graph) resolves the package instead of hitting ERR_PACKAGE_PATH_NOT_EXPORTED. The build is ESM-only; 'default' points at the same ESM output and is loaded via Node's require(ESM) support (Node >=22.12). 'default' MUST be listed last.",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" },
    "./config": { "types": "./dist/config/index.d.ts", "import": "./dist/config/index.js", "default": "./dist/config/index.js" },
    "./lib": { "types": "./dist/lib/index.d.ts", "import": "./dist/lib/index.js", "default": "./dist/lib/index.js" },
    "./http": { "types": "./dist/http/index.d.ts", "import": "./dist/http/index.js", "default": "./dist/http/index.js" },
    "./identity": { "types": "./dist/identity/index.d.ts", "import": "./dist/identity/index.js", "default": "./dist/identity/index.js" },
    "./auth": { "types": "./dist/auth/index.d.ts", "import": "./dist/auth/index.js", "default": "./dist/auth/index.js" },
    "./household": { "types": "./dist/household/index.d.ts", "import": "./dist/household/index.js", "default": "./dist/household/index.js" },
    "./db": { "types": "./dist/db/index.d.ts", "import": "./dist/db/index.js", "default": "./dist/db/index.js" }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "tsx node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx node_modules/drizzle-kit/bin.cjs migrate",
    "db:push": "tsx node_modules/drizzle-kit/bin.cjs push",
    "db:studio": "tsx node_modules/drizzle-kit/bin.cjs studio"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "drizzle-orm": "^0.39.3",
    "hono": "^4.7.4",
    "postgres": "^3.4.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^3.0.8",
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
